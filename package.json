{
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pug": "^3.0.4"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-views && npm run copy-public",
    "clean": "shx rm -rf dist",
    "copy-views": "shx cp -r src/views/ dist",
    "copy-public": "shx cp -r src/public/ dist",
    "start": "node dist/app.js",
    "dev": "node --watch src/app.ts"
  }
}
