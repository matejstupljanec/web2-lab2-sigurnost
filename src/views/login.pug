doctype html
html     
    head 
        title Login
    body
        div
            h1 Login
            form(action="/login", method="POST")
                div
                    label(for="username") Username: 
                    input(type="text", name="username", required)
                br
                div
                    label(for="password") Password: 
                    input(type="password", name="password", required)
                br
                div
                    input(type="submit", value="Login")
        